{
    log {
        format filter {
            wrap json
            fields {
                request>uri regexp "[?].*$" ""
                request>headers>Referer delete
            }
        }
    }
}

https://mycity.private-gateway.site:8080 {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    encode gzip zstd
    reverse_proxy web:80
}
