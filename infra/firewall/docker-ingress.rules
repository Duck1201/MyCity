# External interface: ens5
*filter
:MYCITY-INGRESS - [0:0]
-A MYCITY-INGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
-A MYCITY-INGRESS -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport 22 -j RETURN
-A MYCITY-INGRESS -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport 80 -j RETURN
-A MYCITY-INGRESS -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport 443 -j RETURN
-A MYCITY-INGRESS -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport 8080 -j RETURN
-A MYCITY-INGRESS -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport 9000 -j RETURN
-A MYCITY-INGRESS -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport 40000:40100 -j RETURN
-A MYCITY-INGRESS -p udp -m conntrack --ctdir ORIGINAL --ctorigdstport 51820 -j RETURN
-A MYCITY-INGRESS -p udp -m conntrack --ctdir ORIGINAL --ctorigdstport 40000:40100 -j RETURN
-A MYCITY-INGRESS -j DROP
COMMIT
