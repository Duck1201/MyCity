{
    log {
        format filter {
            wrap json
            fields {
                request>uri regexp "[?].*$" ""
                request>headers>Referer delete
            }
        }
    }
}

{$WEB_ORIGIN} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    encode gzip zstd
    reverse_proxy web:80
}
