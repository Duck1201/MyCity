{
    "name": "mycity",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=24.11 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.19.1",
    "overrides": {
        "@prisma/config@7.10.1": {
            "effect": "3.22.1"
        }
    },
    "scripts": {
        "predev": "node --env-file=.env apps/api/scripts/check-development.mjs && npm run build:contracts",
        "dev": "node scripts/dev.mjs",
        "dev:api": "npm run dev -w @mycity/api",
        "dev:web": "npm run dev -w @mycity/web --",
        "dev:mobile": "npm run start -w @mycity/mobile --",
        "dev:mobile:web": "npm run prototype:pc -w @mycity/mobile --",
        "build": "npm run build -w @mycity/contracts && npm run build -w @mycity/api && npm run build -w @mycity/web",
        "build:contracts": "npm run build -w @mycity/contracts",
        "typecheck": "npm run build:contracts && npm run typecheck --workspaces --if-present",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run build:contracts && npm test --workspaces --if-present && vitest run scripts/tests && npm run test:integration",
        "test:integration": "node scripts/integration.mjs",
        "db:migrate": "npm run db:migrate -w @mycity/api",
        "db:reset": "npm run db:reset -w @mycity/api",
        "db:seed": "npm run db:seed -w @mycity/api",
        "check": "npm run docs:check -w @mycity/api && npm run lint && npm run typecheck && npm test && npm run build",
        "setup": "node scripts/setup-env.mjs && npm run db:generate -w @mycity/api && npm run build:contracts",
        "security:secrets": "node scripts/security/secrets.mjs",
        "security:dependencies": "npm audit --package-lock-only --audit-level=high",
        "security:check": "npm run security:secrets && npm run security:dependencies"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "concurrently": "10.0.7",
        "eslint": "10.15.0",
        "globals": "17.14.0",
        "prettier": "3.10.1",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "vitest": "5.1.1",
        "yaml": "2.9.1"
    },
    "license": "Apache-2.0",
    "scarfSettings": {
        "enabled": false
    }
}
