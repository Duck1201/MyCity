                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "photoId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "Consulta autorizada.", "content": { "image/jpeg": { "schema": { "type": "string", "format": "binary" } } } }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "404": { "description": "Recurso não encontrado." } }
            }
        },
        "/api/v1/reports/{id}/history": {
            "get": {
                "summary": "Consultar histórico da denúncia",
                "security": [{ "WebSession": [] }, { "AndroidSession": [] }],
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
                    { "name": "cursor", "in": "query", "schema": { "type": "string" } },
                    { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["oldest", "newest"], "default": "oldest" } }
                ],
                "responses": { "200": { "description": "Consulta autorizada." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "404": { "description": "Recurso não encontrado." } }
            }
        },
        "/api/v1/reports/{id}/transitions": { "post": { "summary": "Alterar o status da denúncia", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["targetStatus", "expectedVersion"], "properties": { "targetStatus": { "type": "string", "enum": ["SENT", "UNDER_REVIEW", "IN_PROGRESS", "REJECTED", "RESOLVED"], "description": "Destino permitido em allowedActions: avançar, desfazer o último avanço comprovado no histórico ou reabrir em análise." }, "expectedVersion": { "type": "integer", "minimum": 1 }, "reason": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Obrigatória para rejeição." } } } } } }, "responses": { "200": { "description": "Detalhe atualizado, evento e aviso persistidos." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "404": { "description": "Denúncia não encontrada." }, "409": { "description": "Versão desatualizada ou transição inválida." }, "422": { "description": "Campos inválidos." } } } },
        "/api/v1/reports/{id}/replies": { "post": { "summary": "Publicar resposta no histórico, inclusive após encerramento", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["text", "clientRequestId"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 2000 }, "clientRequestId": { "type": "string", "minLength": 1, "maxLength": 128 } } } } } }, "responses": { "200": { "description": "Mesmo evento em reenvio idêntico." }, "201": { "description": "Resposta registrada." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "404": { "description": "Denúncia não encontrada." }, "409": { "description": "A chave já foi usada com outro texto." }, "422": { "description": "Campos inválidos." } } } },
        "/api/v1/notifications": {
            "get": {
                "summary": "Consultar avisos do cidadão",
                "security": [{ "WebSession": [] }, { "AndroidSession": [] }],
                "parameters": [
                    { "name": "unreadOnly", "in": "query", "schema": { "type": "boolean", "default": false } },
                    { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
                    { "name": "cursor", "in": "query", "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "Avisos pessoais em ordem decrescente.", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "page"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/ReportNotification" } }, "page": { "type": "object", "required": ["nextCursor"], "properties": { "nextCursor": { "type": "string", "nullable": true } } } } } } } }, "400": { "description": "Filtro ou cursor inválido." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." } }
            }
        },
        "/api/v1/notifications/{id}/read": { "put": { "summary": "Marcar aviso próprio como lido", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Aviso com a data da primeira leitura.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/ReportNotification" } } } } } }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "404": { "description": "Aviso não encontrado." } } } },
        "/api/v1/reports/map": {
            "get": {
                "summary": "Consultar marcadores na área do mapa",
                "security": [{ "WebSession": [] }, { "AndroidSession": [] }],
