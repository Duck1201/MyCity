                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["SENT", "UNDER_REVIEW", "IN_PROGRESS", "RESOLVED", "REJECTED", "CANCELED"] } },
                    { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Identificador retornado por GET /categories." },
                    { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
                    { "name": "cursor", "in": "query", "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "Consulta autorizada." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "404": { "description": "Recurso não encontrado." } }
            }
        },
        "/api/v1/reports/overview": { "get": { "summary": "Consultar a visão geral de atendimento", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "responses": { "200": { "description": "Indicadores e prioridades da mesma leitura do banco.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["counts", "oldest", "categories", "priorities"], "properties": { "counts": { "type": "object", "required": ["SENT", "UNDER_REVIEW", "IN_PROGRESS", "RESOLVED", "REJECTED", "CANCELED"], "properties": { "SENT": { "type": "integer", "minimum": 0 }, "UNDER_REVIEW": { "type": "integer", "minimum": 0 }, "IN_PROGRESS": { "type": "integer", "minimum": 0 }, "RESOLVED": { "type": "integer", "minimum": 0 }, "REJECTED": { "type": "integer", "minimum": 0 }, "CANCELED": { "type": "integer", "minimum": 0 } } }, "oldest": { "type": "object", "nullable": true, "required": ["id", "createdAt"], "properties": { "id": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } }, "categories": { "type": "array", "items": { "type": "object", "required": ["id", "name", "archived", "count"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "icon": { "type": "string" }, "reportCount": { "type": "integer", "minimum": 0, "description": "Contagem no catálogo do gestor." }, "archived": { "type": "boolean" }, "count": { "type": "integer", "minimum": 0 } } } }, "priorities": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["id", "category", "description", "status", "confirmationCount"], "properties": { "id": { "type": "string" }, "category": { "type": "string" }, "description": { "type": "string" }, "status": { "type": "string", "enum": ["SENT", "UNDER_REVIEW", "IN_PROGRESS", "RESOLVED", "REJECTED", "CANCELED"] }, "confirmationCount": { "type": "integer", "minimum": 0 }, "photoPath": { "type": "string" } } } } } } } } } } }, "400": { "description": "Parâmetros de consulta não aceitos." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." } } } },
        "/api/v1/reports/queue": {
            "get": {
                "summary": "Consultar a fila filtrada do gestor",
                "security": [{ "WebSession": [] }, { "AndroidSession": [] }],
                "parameters": [
                    { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Identificador retornado por GET /categories." },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["SENT", "UNDER_REVIEW", "IN_PROGRESS", "RESOLVED", "REJECTED", "CANCELED", "pending"] } },
                    { "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 160 } },
                    { "name": "de", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Dia inclusivo em America/Sao_Paulo." },
                    { "name": "ate", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Dia inclusivo em America/Sao_Paulo." },
                    { "name": "ordem", "in": "query", "schema": { "type": "string", "enum": ["prioridade", "antigas", "recentes"] } },
                    { "name": "pagina", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 1 } },
                    { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 } }
                ],
                "responses": { "200": { "description": "data, total, counts por situação antes do filtro de situação e page efetiva." }, "400": { "description": "Consulta inválida." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." } }
            }
        },
        "/api/v1/reports/queue.csv": {
            "get": {
                "summary": "Exportar a fila completa no formato CSV",
                "security": [{ "WebSession": [] }, { "AndroidSession": [] }],
                "parameters": [
                    { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Identificador retornado por GET /categories." },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["SENT", "UNDER_REVIEW", "IN_PROGRESS", "RESOLVED", "REJECTED", "CANCELED", "pending"] } },
                    { "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 160 } },
                    { "name": "de", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Dia inclusivo em America/Sao_Paulo." },
                    { "name": "ate", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Dia inclusivo em America/Sao_Paulo." },
                    { "name": "ordem", "in": "query", "schema": { "type": "string", "enum": ["prioridade", "antigas", "recentes"] } }
                ],
                "responses": { "200": { "description": "Mesma consulta e ordenação sem paginação.", "content": { "text/csv": { "schema": { "type": "string" } } } }, "400": { "description": "Consulta inválida." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." } }
            }
        },
        "/api/v1/reports/summary": { "get": { "summary": "Contar denúncias por estado em todas as páginas", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Identificador retornado por GET /categories." }], "responses": { "200": { "description": "Objeto com contagem para cada um dos seis estados." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." } } } },
        "/api/v1/reports/{id}/confirmation": { "put": { "summary": "Confirmar uma ocorrência", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Estado de confirmação pelo cidadão e total da denúncia." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "404": { "description": "Denúncia não encontrada." }, "409": { "description": "Alteração indisponível neste estado." } } }, "delete": { "summary": "Retirar a própria confirmação", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Estado de confirmação pelo cidadão e total da denúncia." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "404": { "description": "Denúncia não encontrada." }, "409": { "description": "Alteração indisponível neste estado." } } } },
        "/api/v1/reports/{id}/cancellation": { "post": { "summary": "Cancelar denúncia própria", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["expectedVersion"], "properties": { "expectedVersion": { "type": "integer", "minimum": 1 } } } } } }, "responses": { "200": { "description": "Detalhe cancelado, histórico e aviso persistidos." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "404": { "description": "Denúncia não encontrada." }, "409": { "description": "Versão desatualizada ou estado incompatível." }, "422": { "description": "Campos inválidos." } } } },
