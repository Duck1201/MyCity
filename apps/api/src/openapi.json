                "responses": { "200": { "description": "Cenários em ordem de gravidade para a data fictícia da demonstração.", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "page"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/WeatherAlert" } }, "page": { "type": "object", "required": ["nextCursor"], "properties": { "nextCursor": { "type": "string", "nullable": true } } } } } } } }, "400": { "description": "Parâmetros ou cursor inválidos." }, "401": { "description": "Sessão ausente, expirada ou revogada." } }
            }
