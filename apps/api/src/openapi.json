{
    "openapi": "3.0.3",
    "info": { "title": "MyCity API", "version": "0.1.0", "description": "Contrato gerado das rotas implementadas. Sessões, denúncias, atendimento, notificações e alertas climáticos simulados. Esta interface só é habilitada no desenvolvimento local." },
    "servers": [{ "url": "/", "description": "Mesma origem da documentação" }],
    "tags": [{ "name": "Saúde", "description": "Verificações operacionais públicas sem dados pessoais." }],
    "paths": {
        "/api/v1/health/live": { "get": { "tags": ["Saúde"], "summary": "Verificar se o processo está ativo", "description": "", "responses": { "200": { "description": "Processo ativo; não consulta o banco.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Liveness" } } } }, "429": { "description": "Cota por origem atingida. Aguarde o intervalo indicado em segundos.", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "enum": ["TOO_MANY_REQUESTS"] }, "message": { "type": "string" } } } } } } } } } } },
        "/api/v1/health/ready": { "get": { "tags": ["Saúde"], "summary": "Verificar disponibilidade do banco e da migração", "description": "", "responses": { "200": { "description": "API pronta.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } } }, "429": { "description": "Cota por origem atingida. Aguarde o intervalo indicado em segundos.", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "enum": ["TOO_MANY_REQUESTS"] }, "message": { "type": "string" } } } } } } } }, "503": { "description": "Dependência indisponível; sem detalhes internos.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Unavailable" } } } } } } },
        "/api/v1/sessions": { "post": { "summary": "Iniciar sessão por CPF e senha", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["cpf", "password", "transport"], "properties": { "cpf": { "type": "string" }, "password": { "type": "string", "format": "password" }, "transport": { "type": "string", "enum": ["cookie", "bearer"] } } } } } }, "responses": { "201": { "description": "Identidade e expiresAt. O transporte bearer também retorna token." }, "400": { "description": "Entrada inválida." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "429": { "description": "Cota por origem atingida. Aguarde o intervalo indicado em segundos.", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "enum": ["TOO_MANY_REQUESTS"] }, "message": { "type": "string" } } } } } } } } } } },
        "/api/v1/me": { "get": { "summary": "Consultar identidade da sessão", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [], "responses": { "200": { "description": "Consulta autorizada.", "headers": { "X-Session-Expires-At": { "description": "Fim da validade original da sessão, em UTC.", "schema": { "type": "string", "format": "date-time" } } } }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "404": { "description": "Recurso não encontrado." } } } },
        "/api/v1/sessions/current": { "delete": { "summary": "Revogar a sessão atual", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "responses": { "204": { "description": "Sessão revogada." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." } } } },
        "/api/v1/reports": {
            "get": {
                "summary": "Consultar feed, denúncias próprias, resolvidas ou fila de gestão",
                "security": [{ "WebSession": [] }, { "AndroidSession": [] }],
                "parameters": [
                    { "name": "scope", "in": "query", "required": true, "schema": { "type": "string", "enum": ["management", "mine", "resolved", "feed"] } },
                    { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["SENT", "UNDER_REVIEW", "IN_PROGRESS", "RESOLVED", "REJECTED", "CANCELED"] } },
                    { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Identificador retornado por GET /categories." },
                    { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["priority", "newest"] } },
                    { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
                    { "name": "cursor", "in": "query", "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "Lista paginada com page.nextCursor." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." } }
            },
            "post": { "summary": "Publicar denúncia como cidadão", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["metadata", "photos"], "properties": { "metadata": { "type": "string", "description": "JSON com category, description, location, clientRequestId e showIdentity." }, "photos": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "format": "binary" } } } } } } }, "responses": { "200": { "description": "Reenvio da mesma denúncia." }, "201": { "description": "Denúncia criada." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "403": { "description": "Operação não permitida." }, "409": { "description": "Chave reutilizada com outro conteúdo, perfil indisponível ou categoria arquivada (CATEGORY_ARCHIVED)." }, "413": { "description": "Limite de tamanho excedido." }, "415": { "description": "Tipo de mídia inválido." }, "422": { "description": "Dados inválidos." }, "429": { "description": "Limite de envio atingido." }, "507": { "description": "Espaço insuficiente para armazenar as fotos." } } }
        },
        "/api/v1/reports/{id}": { "get": { "summary": "Consultar detalhes da denúncia", "security": [{ "WebSession": [] }, { "AndroidSession": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Consulta autorizada." }, "401": { "description": "Sessão ausente, expirada ou revogada." }, "404": { "description": "Recurso não encontrado." } } } },
