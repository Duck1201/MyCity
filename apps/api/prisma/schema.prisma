generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN @map("citizen")
  MANAGER @map("manager")

  @@map("user_role")
}

model User {
  loginEnabled Boolean  @default(false) @map("login_enabled")
  id           String   @id @default(uuid()) @map("id")
  cpf          String   @unique @map("cpf") @db.VarChar(11)
  password     String   @map("password")
  role         Role     @map("role")
  createdAt    DateTime @default(now()) @map("created_at")
  modifiedAt   DateTime @default(now()) @updatedAt @map("modified_at")

  sessions      Session[]
  profile       Profile?
  reports       Report[]
  notifications Notification[]
  reportEvents  ReportEvent[]
  confirmations ReportConfirmation[]

  @@map("users")
}

model Session {
  credentialHash String   @map("credential_hash") @db.Char(64)
  tokenHash      String   @id @map("token_hash") @db.Char(64)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transport      String   @map("transport")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("sessions")
}

model Profile {
  userId     String   @id @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   @map("name")
  photoUrl   String   @map("photo_url")
  createdAt  DateTime @default(now()) @map("created_at")
  modifiedAt DateTime @default(now()) @updatedAt @map("modified_at")

  @@map("profiles")
}

model ReportCategoryDefinition {
  id         String   @id @default(uuid()) @map("id")
  name       String   @map("name") @db.VarChar(80)
  icon       String?  @db.VarChar(20)
  archived   Boolean  @default(false)
  nameKey    String   @unique @map("name_key")
  position   Int      @default(6) @map("position")
  createdAt  DateTime @default(now()) @map("created_at")
  modifiedAt DateTime @default(now()) @updatedAt @map("modified_at")
  reports    Report[]

  @@map("report_categories")
}

enum ReportStatus {
  SENT         @map("sent")
  UNDER_REVIEW @map("under_review")
  IN_PROGRESS  @map("in_progress")
  RESOLVED     @map("resolved")
  REJECTED     @map("rejected")
  CANCELED     @map("canceled")

  @@map("report_status")
}

enum LocationSource {
  GPS    @map("gps")
  MANUAL @map("manual")

  @@map("location_source")
}

model Report {
  id                 String                   @id @default(uuid()) @map("id")
  authorId           String                   @map("author_id")
  author             User                     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  clientRequestId    String                   @map("client_request_id") @db.VarChar(128)
  requestHash        String                   @map("request_hash") @db.Char(64)
  category           String                   @map("category")
  categoryDefinition ReportCategoryDefinition @relation(fields: [category], references: [id], onDelete: Restrict)
  description        String                   @map("description") @db.VarChar(1000)
  latitude           Float                    @map("latitude")
  longitude          Float                    @map("longitude")
  locationSource     LocationSource           @map("location_source")
  showIdentity       Boolean                  @map("show_identity")
  status             ReportStatus             @default(SENT) @map("status")
  version            Int                      @default(1) @map("version")
  photosExpireAt     DateTime?                @map("photos_expire_at")
  photosPurgedAt     DateTime?                @map("photos_purged_at")
  photos             ReportPhoto[]
  confirmations      ReportConfirmation[]
  notifications      Notification[]
  events             ReportEvent[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  modifiedAt         DateTime                 @default(now()) @updatedAt @map("modified_at")

  @@index([photosPurgedAt, photosExpireAt])
  @@unique([authorId, clientRequestId])
  @@index([createdAt, id])
  @@map("reports")
}

model ReportPhoto {
  id       String @id @default(uuid()) @map("id")
  reportId String @map("report_id")
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  position Int    @map("position")
  width    Int    @map("width")
  height   Int    @map("height")
  byteSize Int    @map("byte_size")

  @@unique([reportId, position])
  @@map("report_photos")
}

model ReportEvent {
  id              String         @id @default(uuid()) @map("id")
  reportId        String         @map("report_id")
  report          Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId         String         @map("actor_id")
  actor           User           @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "report_events_actor_fk")
  type            String         @map("type")
  fromStatus      ReportStatus?  @map("from_status")
  toStatus        ReportStatus?  @map("to_status")
  text            String?        @map("text") @db.VarChar(2000)
  clientRequestId String?        @map("client_request_id") @db.VarChar(128)
  notifications   Notification[]
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([reportId, actorId, clientRequestId])
  @@index([reportId, createdAt, id])
  @@map("report_events")
}

model Notification {
  id          String       @id @default(uuid()) @map("id")
  eventId     String       @map("event_id")
  event       ReportEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reportId    String       @map("report_id")
  report      Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipientId String       @map("recipient_id")
  recipient   User         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  status      ReportStatus @map("status")
  createdAt   DateTime     @default(now()) @map("created_at")
  modifiedAt  DateTime     @default(now()) @updatedAt @map("modified_at")
  readAt      DateTime?    @map("read_at")

  @@unique([eventId, recipientId])
  @@index([recipientId, createdAt, id])
  @@map("notifications")
}

model ReportConfirmation {
  reportId  String   @map("report_id")
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([reportId, userId])
  @@map("report_confirmations")
}
